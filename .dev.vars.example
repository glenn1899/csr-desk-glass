# Local secrets for `npx wrangler dev`.
# Copy this file to .dev.vars. .dev.vars is gitignored. Do not commit real values.
# Leave everything blank to preview with sample events.
#
# The refresh token normally lives in the CAL_KV binding, saved by /auth/start.
# CAL_KV is a KV binding in Cloudflare, not a line in this file.

# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
# CALENDAR_ID="primary"
# CALENDAR_IDS="primary"
# CALENDAR_NAMES="Broker Support Team"

# Optional fallback when CAL_KV has no refresh token.
# GOOGLE_REFRESH_TOKEN=""
