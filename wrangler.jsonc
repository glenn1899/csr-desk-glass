{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "csr-desk-glass",
  "main": "src/index.js",
  // Set this to today's date
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    // Invocation logs store request headers. Traces record header names, not values.
    // Query strings can carry the OAuth code, so drop them from logs and traces.
    "redact_query_string": true,
    "logs": {
      "invocation_logs": false
    },
    "traces": {
      "enabled": true
    }
  },
  "rules": [
    { "type": "Text", "globs": ["**/*.html"], "fallthrough": false }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "dry-mud-91ba.cloudflareaccess.com",
    "ACCESS_AUD": "f3e04809e143ccb2737c5becfe83dd36c5852415051eb808ff95e638974bdec5",
    "ALLOWED_EMAIL": "glenn@oibc.ca"
  },
  "kv_namespaces": [
    {
      "binding": "CAL_KV",
      // Namespace name: csr-desk-glass-cal.
      "id": "27f2ee8d076b4394a7eb1a3554deeb89"
    }
  ],
  "previews": {
    // No CAL_KV here, so a preview cannot read or write the production calendar store.
    // Connecting on a preview returns "Calendar storage is not configured."
    "vars": {
      "ACCESS_TEAM_DOMAIN": "dry-mud-91ba.cloudflareaccess.com",
      "ACCESS_AUD": "f3e04809e143ccb2737c5becfe83dd36c5852415051eb808ff95e638974bdec5",
      "ALLOWED_EMAIL": "glenn@oibc.ca"
    }
  }
}
